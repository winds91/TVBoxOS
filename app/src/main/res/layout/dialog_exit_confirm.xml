<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_400"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/vs_30"
        tools:ignore="UselessParent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_20"
            android:text="是否退出？"
            android:textColor="@color/color_CC000000"
            android:textSize="@dimen/ts_26" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_20"
                android:layout_marginRight="@dimen/vs_20"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_30"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_30"
                android:paddingBottom="@dimen/vs_10"
                android:text="确定"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_30"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_30"
                android:paddingBottom="@dimen/vs_10"
                android:text="取消"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
